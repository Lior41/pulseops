# Copy to .env. Never commit .env. `npm run demo` can create a local .env automatically.
DATABASE_URL=postgresql://pulseops:pulseops_local_only@127.0.0.1:5432/pulseops
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
# Only behind a trusted host/proxy; required for the local production server.
AUTH_TRUST_HOST=true
DEMO_MODE=true
DEMO_PASSWORD=PulseOps-Demo-2026!
# Optional initial administrator. No default admin password is shipped.
ADMIN_PASSWORD=
POSTGRES_PASSWORD=pulseops_local_only
# Development-only PostgreSQL WASM runner, never used on Vercel or in Docker.
LOCAL_DB_PORT=54329
# Separate disposable test database. Never point tests at application data.
TEST_DATABASE_URL=postgresql://pulseops:pulseops_local_only@127.0.0.1:5432/pulseops_test
